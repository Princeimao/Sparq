PORT=4000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:password@localhost:5432/sparq

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

ENCRYPTION_KEY=a-32-byte-hex-key-for-aes-256-gcm-change-me

WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token

STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_PLAN_GROWTH_MONTHLY=plan_xxxx
RAZORPAY_PLAN_GROWTH_YEARLY=plan_xxxx
RAZORPAY_PLAN_PRO_MONTHLY=plan_xxxx
RAZORPAY_PLAN_PRO_YEARLY=plan_xxxx

FRONTEND_URL=http://localhost:3000
# Hosted: your exact Vercel URL (comma-separated for previews), e.g.
# FRONTEND_URL=https://sparq.vercel.app,https://sparq-git-main-team.vercel.app
# Session cookies: production cross-site hosting needs SameSite=None; Secure
# (the default when NODE_ENV=production). Override only for exotic setups.
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true

# Object storage — direct-to-bucket uploads via presigned URLs.
# Files land in per-user folders: u/<userId>/<purpose>/<yyyy>/<mm>/<file>
# so the bucket stays browsable and attributable.
STORAGE_PROVIDER=s3
S3_BUCKET=sparq-uploads
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret
# Optional: S3-compatible store (R2/MinIO) and a CDN in front of the bucket.
# S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=https://cdn.yourdomain.com
UPLOAD_MAX_IMAGE_MB=8
UPLOAD_URL_TTL_SEC=900
