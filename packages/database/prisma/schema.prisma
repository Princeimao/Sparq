generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum IntegrationType {
  STRIPE
  RAZORPAY
  CALCOM
  GOOGLE_CALENDAR
  WOOCOMMERCE
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
}

enum ConversationStep {
  INITIAL
  WAITING_CONFIRMATION
  WAITING_ADDRESS
  WAITING_PAYMENT
  COMPLETED
  CANCELLED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum FlowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BookingMode {
  ANY_STAFF
  SELECT_STAFF
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AvailabilityMode {
  MANUAL
  GENERATED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  TEMPLATE
  INTERACTIVE
  FLOW
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}


// ─── Core Auth & Org ─────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  googleId  String?  @unique

  integrations Integration[]
  whatsappIntegrations WhatsappIntegration?
  customers    Customer[]
  orders       Order[]
  products     Product[]
  appointments Appointment[]
  workflows    Workflow[]
  flows        Flow[]
  service      Service[]
  staff        Staff[]
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Integration {
  id String @id @default(cuid())

  userId String
  type           IntegrationType

  name     String
  isActive Boolean @default(true)

  credentials Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("integrations")
}

model WhatsappIntegration {
  id String @id @default(cuid())

  userId String @unique
  isActive Boolean @default(true)

  businessId   String
  wabaId        String
  phoneNumberId String
  accessToken   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("whatsapp_integrations")
}

model Customer {
  id String @id @default(cuid())

  userId String
  phone      String
  name       String?
  email      String?
  customFields Json?

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]
  conversations ConversationState[]
  messages      Message[]
  addresses     Address[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, phone])
  @@index([userId])
  @@map("customers")
}

model Address {
  id String @id @default(cuid())
  customerId String

  type AddressType @default(SHIPPING)
  name        String?
  phone       String?

  line1       String
  line2       String?

  city        String
  state       String
  country     String @default("India")

  pincode     String
  landmark    String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

enum AddressType {
  SHIPPING
  BILLING
}


model Order {
  id String @id @default(cuid())

  userId String
  customerId     String
  shippingAddressId      String?

  productName   String
  amount        Float?
  currency      String?          @default("INR")
  status        OrderStatus      @default(PENDING)
  purchaseDate  DateTime         @default(now())
  paymentId     String?          
  paymentLink   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer      Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shippingAddress       Address?         @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  conversation  ConversationState?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model ConversationState {
  id String @id @default(cuid())

  customerId String
  orderId    String? @unique

  step          ConversationStep @default(INITIAL)
  contextData   Json?          
  lastMessageAt DateTime         @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([step])
  @@map("conversation_states")
}

model Message {
  id String @id @default(cuid())
  customerId String
  userId     String
  waMessageId String? @unique

  direction MessageDirection
  type MessageType

  body String?
  payload Json?
  templateName String?
  status MessageStatus @default(SENT)
  
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, createdAt])
  @@index([userId, createdAt])
  @@index([waMessageId])
  @@map("messages")
}

model Product {
  id             String   @id @default(cuid())
  userId String
  name           String
  description    String?
  price          Float
  image          String?
  stock          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("products")
}

model Workflow {
  id             String   @id @default(cuid())
  userId String
  name           String
  description    String?
  triggerType    String   
  steps          Json     
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("workflows")
}

model Flow {
  id              String      @id @default(cuid())
  name            String

  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  status          FlowStatus  @default(DRAFT)

  flowSchema      Json        
  whatsappSchema  Json?      

  endpointUrl     String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@map("flows")
}


model Service {
  id          String   @id @default(cuid())
  userId      String

  name        String
  description String?
  duration    Int      // minutes

  bookingMode     BookingMode     @default(ANY_STAFF)
  availabilityMode AvailabilityMode @default(MANUAL)

  price       Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  staff Staff[]

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Staff {
  id       String @id @default(cuid())
  userId   String

  name     String
  email    String?
  phone    String?

  isActive Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  services Service[]

  availability Availability[]

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Availability {
  id String @id @default(cuid())

  staffId String?

  dayOfWeek Int

  startTime String
  endTime   String

  capacity Int @default(1)

  isActive Boolean @default(true)

  staff Staff? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
}


model Appointment {
  id String @id @default(cuid())

  userId String

  serviceId String

  // nullable because salon may assign later
  staffId String?

  customerName  String
  customerEmail String?
  customerPhone String?

  startTime DateTime
  endTime   DateTime

  status AppointmentStatus @default(PENDING)

  notes String?

  service Service @relation(fields: [serviceId], references: [id])

  staff Staff? @relation(fields: [staffId], references: [id])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([serviceId])
  @@index([staffId])
  @@index([startTime])
}
