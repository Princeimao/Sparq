generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum IntegrationType {
  STRIPE
  RAZORPAY
  CALCOM
  GOOGLE_CALENDAR
  WOOCOMMERCE
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
}

enum ConversationStep {
  INITIAL
  WAITING_CONFIRMATION
  WAITING_ADDRESS
  WAITING_PAYMENT
  COMPLETED
  CANCELLED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum FlowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BookingMode {
  ANY_STAFF
  SELECT_STAFF
}

// ─── Unified booking domain ─────────────────────────────────────────────────

enum ResourceKind {
  STAFF
  TABLE
  ROOM
  EQUIPMENT
  OTHER
}

enum AssignmentMode {
  CUSTOMER_CHOICE
  BUSINESS_ASSIGN
  AUTO
  SINGLE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  CHECKED_IN
}

enum BookingSource {
  WHATSAPP
  DASHBOARD
  API
}

enum AvailabilityMode {
  MANUAL
  GENERATED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  TEMPLATE
  INTERACTIVE
  FLOW
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum SubscriptionPlan {
  FREE
  GROWTH
  PRO
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  PAUSED
  CANCELED
  EXPIRED
  PAST_DUE
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  RAZORPAY
}

enum BusinessType {
  SALON
  CLINIC
  RESTAURANT
  HOTEL
  RETAIL
  HOME_SERVICES
  FITNESS
  OTHER
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ServiceLocation {
  AT_BUSINESS
  AT_CUSTOMER
  BOTH
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  googleId  String?  @unique

  integrations Integration[]
  whatsappIntegrations WhatsappIntegration?
  customers    Customer[]
  orders       Order[]
  products     Product[]
  flows        Flow[]
  service      Service[]
  staff        Staff[]
  messages Message[]
  resources    Resource[]
  bookings     Booking[]
  timeOffs     TimeOff[]
  breaks       Break[]
  payments    Payment[]
  subscriptions Subscription[]
  businessProfile BusinessProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Payment {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  provider PaymentProvider @default(RAZORPAY)

  status PaymentStatus

  amount   Int
  currency String @default("INR")

  providerPaymentId String? @unique
  providerOrderId   String? @unique
  providerInvoiceId String?

  method String?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([providerPaymentId])
  @@index([providerOrderId])
  @@map("payments")
}

model Subscription {
  id String @id @default(cuid())

  userId String @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan     SubscriptionPlan @default(FREE)
  interval BillingInterval  @default(MONTHLY)
  status   SubscriptionStatus @default(ACTIVE)

  amount   Int
  currency String @default("INR")

  provider PaymentProvider @default(RAZORPAY)

  providerSubscriptionId String? @unique

  providerCustomerId String?
  providerPlanId     String?

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  cancelAtPeriodEnd Boolean   @default(false)
  canceledAt        DateTime?

  startedAt DateTime?

  endedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([status])
  @@index([plan])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model Integration {
  id String @id @default(cuid())

  userId String
  type           IntegrationType

  name     String
  isActive Boolean @default(true)

  credentials Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("integrations")
}

model WhatsappIntegration {
  id String @id @default(cuid())

  userId String @unique
  isActive Boolean @default(true)

  businessId   String
  wabaId        String
  phoneNumberId String
  accessToken   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("whatsapp_integrations")
}

model Customer {
  id String @id @default(cuid())

  userId String
  phone      String
  name       String?
  email      String?
  customFields Json?
  notes String?

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]
  conversations ConversationState[]
  messages      Message[]
  addresses     Address[]
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, phone])
  @@index([userId])
  @@map("customers")
}

model Address {
  id String @id @default(cuid())
  customerId String

  type AddressType @default(SHIPPING)
  label String?
  isDefault Boolean @default(false)
  name        String?
  phone       String?

  line1       String
  line2       String?

  city        String
  state       String
  country     String @default("India")

  pincode     String
  landmark    String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders Order[]
  visitBookings Booking[] @relation("VisitAddress")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

enum AddressType {
  SHIPPING
  BILLING
}


model Order {
  id String @id @default(cuid())

  userId String
  customerId     String
  shippingAddressId      String?

  productName   String
  amount        Float?
  currency      String?          @default("INR")
  status        OrderStatus      @default(PENDING)
  purchaseDate  DateTime         @default(now())
  paymentId     String?          
  paymentLink   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer      Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shippingAddress       Address?         @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  conversation  ConversationState?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model ConversationState {
  id String @id @default(cuid())

  customerId String
  orderId    String? @unique

  step          ConversationStep @default(INITIAL)
  contextData   Json?          
  lastMessageAt DateTime         @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([step])
  @@map("conversation_states")
}

model Message {
  id String @id @default(cuid())
  customerId String
  userId     String
  waMessageId String? @unique

  direction MessageDirection
  type MessageType

  body String?
  payload Json?
  templateName String?
  status MessageStatus @default(SENT)
  
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, createdAt])
  @@index([userId, createdAt])
  @@index([waMessageId])
  @@map("messages")
}

model Product {
  id             String   @id @default(cuid())
  userId String
  name           String
  description    String?
  price          Float
  image          String?
  stock          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("products")
}

model Flow {
  id              String      @id @default(cuid())
  name            String

  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  status          FlowStatus  @default(DRAFT)

  flowSchema      Json        
  whatsappSchema  Json?      

  endpointUrl     String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@map("flows")
}


model Service {
  id          String   @id @default(cuid())
  userId      String

  name        String
  description String?
  duration    Int      // minutes

  bookingMode     BookingMode     @default(ANY_STAFF)
  availabilityMode AvailabilityMode @default(MANUAL)
  locationMode    ServiceLocation @default(AT_BUSINESS)

  // Unified booking configuration
  assignmentMode AssignmentMode @default(BUSINESS_ASSIGN)
  requiresPartySize Boolean @default(false)
  bufferMinutes Int @default(0)
  minLeadMinutes Int @default(0)
  maxAdvanceDays Int?

  price       Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  staff Staff[]
  resourceLinks ServiceResource[]

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Staff {
  id       String @id @default(cuid())
  userId   String

  name     String
  email    String?
  phone    String?

  role      String?
  specialty String?
  image     String?
  color     String?

  isActive Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  services Service[]

  availability Availability[]
  timeOffs     TimeOff[]
  breaks       Break[]

  allocations BookingAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Availability {
  id String @id @default(cuid())

  staffId String?
  resourceId String?

  dayOfWeek Int

  startTime String
  endTime   String

  capacity Int @default(1)

  isActive Boolean @default(true)

  staff Staff? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([resourceId])
}


// ─── Unified booking domain ───────────────────────────────────────────────────
// A Service is the offering. A Resource is who/what fulfills it (people via
// Staff, spaces & equipment via Resource). A Booking links customer +
// offering + time + the allocated resources.

model Resource {
  id     String @id @default(cuid())
  userId String

  name        String
  kind        ResourceKind @default(OTHER)
  description String?
  image       String?
  color       String?

  // Tables / rooms: how many guests fit. Null = not capacity-constrained.
  capacity Int?

  isActive Boolean @default(true)

  locationMode ServiceLocation?

  metadata Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  serviceLinks ServiceResource[]

  availability Availability[]
  timeOffs     TimeOff[]
  breaks       Break[]
  allocations  BookingAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, kind])
}

model ServiceResource {
  serviceId  String
  resourceId String

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([serviceId, resourceId])
  @@index([resourceId])
  @@map("service_resources")
}

model TimeOff {
  id     String @id @default(cuid())
  userId String

  staffId    String?
  resourceId String?

  startDate DateTime
  endDate   DateTime
  reason    String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  staff    Staff?    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([staffId])
  @@index([resourceId])
  @@map("time_offs")
}

model Break {
  id     String @id @default(cuid())
  userId String

  staffId    String?
  resourceId String?

  dayOfWeek Int
  startTime String
  endTime   String
  label     String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  staff    Staff?    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([staffId])
  @@index([resourceId])
  @@map("breaks")
}

model Booking {
  id String @id @default(cuid())

  userId String

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Transaction-time snapshot — history stays accurate if names change.
  customerName  String
  customerEmail String?
  customerPhone String?

  locationMode ServiceLocation?
  visitAddressId String?
  visitAddress Address? @relation("VisitAddress", fields: [visitAddressId], references: [id], onDelete: SetNull)

  startTime DateTime
  endTime   DateTime

  status BookingStatus @default(PENDING)
  source BookingSource @default(DASHBOARD)

  // Restaurant-style bookings.
  partySize Int?

  notes String?
  totalAmount Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  allocations BookingAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([serviceId])
  @@index([customerId])
  @@index([startTime])
  @@index([userId, startTime])
  @@map("bookings")
}

model BookingAllocation {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  staffId String?
  staff   Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  resourceId String?
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  // PRIMARY | ROOM | ASSISTANT | TABLE ...
  role String @default("PRIMARY")

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([staffId])
  @@index([resourceId])
  @@map("booking_allocations")
}


model WebhookEvent {
  id String @id @default(cuid())

  provider PaymentProvider @default(RAZORPAY)

  // Razorpay event id (e.g. from webhook payload `id`). Unique => idempotent.
  eventId String @unique
  type    String

  payload Json

  processedAt DateTime?

  createdAt DateTime @default(now())

  @@index([type])
  @@map("webhook_events")
}

// ─── Business onboarding / personalization ────────────────────────────────────

model BusinessProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName String?
  businessType BusinessType?
  description String?
  contactEmail String?
  contactPhone String?
  industry String?
  servicesOffered String[] @default([])

  // Subset of: "products" | "bookings" (customers & conversations are core)
  enabledModules String[] @default([])

  addressLine1 String?
  city         String?
  state        String?
  pincode      String?
  country      String  @default("India")

  locationMode ServiceLocation?
  serviceArea String?
  timezone String @default("Asia/Kolkata")

  operatingHours Json?
  staffCount Int?

  communicationPrefs Json?
  settings Json?

  onboardingStatus OnboardingStatus @default(NOT_STARTED)
  onboardingStep Int @default(0)
  onboardingDraft Json?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("business_profiles")
}
